# syntax=docker/dockerfile:1.6
# ============================================================
# Stage 1: Build libtranscribe from source with HIP / ROCm support
# ============================================================
FROM rocm/dev-ubuntu-22.04:7.2 AS builder

# Default ROCm arch(es) to target — override at build time via --build-arg.
# `rocminfo | grep gfx` prints the right value for your GPU. Pass a
# semicolon-separated list for several architectures. ROCm 7.2 supports
# gfx900 through gfx120x; transcribe.cpp uses HIP through ggml.
ARG AMDGPU_TARGETS="gfx1030;gfx1100;gfx1101;gfx1150;gfx1200;gfx1201"
ARG TRANSCRIBE_CPP_REF=main

# Build tools + transcribe.cpp deps. The HIP toolchain lives in the base image.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        rocm-hip-runtime-dev hipblas-common-dev hipblas-dev hipcub-dev \
        hiprand-dev rocprim-dev rocrand-dev rocthrust-dev \
        python3-dev python3-pip wget git ca-certificates \
        cmake build-essential libopenblas-dev && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /root

# Build libtranscribe with HIP backend. Output: /usr/local/lib/libtranscribe.so
RUN git clone --depth 1 --branch ${TRANSCRIBE_CPP_REF} \
        https://github.com/handy-computer/transcribe.cpp.git /tmp/transcribe.cpp && \
    cmake -S /tmp/transcribe.cpp -B /tmp/transcribe.cpp/build \
        -DTRANSCRIBE_BUILD_SHARED=ON \
        -DTRANSCRIBE_HIP=ON \
        -DAMDGPU_TARGETS="${AMDGPU_TARGETS}" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local && \
    cmake --build /tmp/transcribe.cpp/build --target transcribe -- -j"$(nproc)" && \
    cmake --install /tmp/transcribe.cpp/build --prefix /usr/local && \
    rm -rf /tmp/transcribe.cpp

# ============================================================
# Stage 2: Final runtime image
# ============================================================
FROM rocm/dev-ubuntu-22.04:7.2

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        rocm-hip-libraries python3-pip \
        ffmpeg python3 curl gosu tzdata \
        libavcodec-dev libavformat-dev libavutil-dev libswresample-dev \
        libopenblas-dev \
        python-is-python3 \
    && ldconfig \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy the freshly built libtranscribe.so from the builder stage.
COPY --from=builder /usr/local/lib/libtranscribe.so /usr/local/lib/libtranscribe.so
RUN ldconfig

# torch nightly with rocm7.2 — only used for the optional CUDA cache clear path
RUN python3 -m pip install --no-cache-dir -U --pre \
        torch --index-url https://download.pytorch.org/whl/nightly/rocm7.2

# Application Python deps — transcribe-cpp native GGUF runtime handles the rest.
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install -U \
        numpy fastapi requests uvicorn python-multipart ffmpeg-python \
        watchdog av tqdm more-itertools transformers tokenizers huggingface-hub scipy \
        transcribe-cpp

# Application files
COPY entrypoint.sh /
WORKDIR /subgen
COPY launcher.py subgen.py language_code.py parakeet_gguf.py /subgen/
RUN mkdir -p /cache /subgen/models && chmod 777 /cache /subgen/models

# Caches
ENV XDG_CACHE_HOME=/cache \
    HF_HOME=/cache/huggingface \
    MPLCONFIGDIR=/cache/matplotlib

# Library paths and HSA preload
ENV LD_LIBRARY_PATH="/usr/local/lib:/opt/rocm-7.2.0/lib:/opt/rocm-7.2.0/lib64:${LD_LIBRARY_PATH}"
ENV LD_PRELOAD="/opt/rocm-7.2.0/lib/libhsa-runtime64.so.1"
ENV CT2_CUDA_ALLOCATOR="cub_caching"
# Point transcribe-cpp at the freshly built shared library.
ENV TRANSCRIBE_LIBRARY=/usr/local/lib/libtranscribe.so

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python3", "-u", "launcher.py"]
